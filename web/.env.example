# Docker Compose environment (copy to .env, then fill the required values).
# For bare-metal local development use backend/.env and gateway/.env instead.

ENVIRONMENT=production
HTTP_PORT=8080

# PostgreSQL (used by both db container and connection strings below)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=warehouse_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Backend (FastAPI) - asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-database-password@db:5432/warehouse_management
# REQUIRED: generate with `openssl rand -hex 32` (or any 64-char random hex).
# The gateway and backend must share the exact same value.
JWT_SECRET=replace-with-a-unique-64-char-random-hex-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false

# Gateway (Node.js)
PORT=3001
PYTHON_BACKEND_URL=http://backend:8001
CORS_ORIGINS=http://localhost:8080

# Frontend build (served by nginx, proxied to the gateway)
VITE_API_URL=/api

# Optional first-run administrator (leave password empty to skip)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
