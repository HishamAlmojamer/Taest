# ERP Web System - Environment Variables
# Copy this to .env and customize

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warehouse_management
JWT_SECRET=erp-super-secret-key-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true

# Gateway (Node.js)
PORT=3001
PYTHON_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Frontend (React)
VITE_API_URL=http://localhost:3001/api
